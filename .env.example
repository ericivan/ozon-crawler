# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ozon_analyzer
DB_USER=root
DB_PASS=your_password

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Proxy
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Scraper
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=5
SCRAPE_MAX_PAGES=3

# Frontend (used by Vite)
VITE_API_BASE_URL=http://localhost:8000
